{
  "name": "mio-doctors-api",
  "version": "1.0.0",
  "description": "MIO Doctors REST API (Express + MongoDB)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db": "node scripts/dev-db.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed.js --demo",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.js down",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate.js status",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-password.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
