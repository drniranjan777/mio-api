# /var/www/miodoctors/backend/.env  (chmod 600, owner: deploy)  — never commit
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
API_PREFIX=/api/v1

# Public address of this API (used in image links) and where uploaded images live
PUBLIC_BASE_URL=https://api.miodoctors.com
UPLOADS_DIR=/var/www/miodoctors/uploads

# MongoDB on the same server, with authentication (see DEPLOYMENT.md step 5)
MONGODB_URI=mongodb://mio_app:CHANGE_ME@127.0.0.1:27017/mio_doctors?authSource=mio_doctors

# Generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=

# Must stay false in production. Until an SMS gateway is added, app sign-in
# answers "SMS not available yet" (the admin panel works normally).
OTP_DEV_MODE=false
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5

# Only the admin panel's origin (the mobile app sends no Origin header)
CORS_ORIGINS=https://admin.miodoctors.com

# Redis (DEPLOYMENT.md step 5b) holds the rate-limit counters so the API can run
# one worker per CPU (PM2 cluster mode). Leave empty to run a single process.
REDIS_URL=redis://127.0.0.1:6379/0
# Workers when REDIS_URL is set; empty = one per CPU. On a 2-vCPU VPS that also
# runs MongoDB, 2 is a good start.
API_INSTANCES=

TZ_OFFSET_MINUTES=330
LOG_LEVEL=info

# No real payment gateway yet → keep payments off (free plans still work)
PAYMENT_PROVIDER=mock
PAYMENTS_ENABLED=false
PAYMENT_ORDER_TTL_MINUTES=30

# Only for the first `npm run seed`; remove the password line afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
