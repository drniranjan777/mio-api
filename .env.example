# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Image uploads (banners). PUBLIC_BASE_URL defaults to http://localhost:PORT
# PUBLIC_BASE_URL=https://api.miodoctors.com
UPLOADS_DIR=uploads

MONGODB_URI=mongodb://127.0.0.1:27017/mio_doctors

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=

# Dev-mode OTP returns the code in the API response. Must be false in production.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5

# Comma-separated origins allowed by CORS (Flutter web dev server, admin panel)
CORS_ORIGINS=http://localhost:8686,http://localhost:5173

# India Standard Time; used to build appointment slots
TZ_OFFSET_MINUTES=330

# Payments: only the mock provider exists (refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
PAYMENT_ORDER_TTL_MINUTES=30

LOG_LEVEL=info

# Used only by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
